# tracellm-faultline environment configuration
# Copy to .env and fill in your values. Never commit .env.

# --- Model providers ---
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=http://localhost:11434

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./faultline.db
# For PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/faultline

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---
VITE_API_BASE_URL=http://localhost:8000
